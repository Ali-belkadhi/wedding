---
import { wedding } from '../data/wedding';
---

<section id="hero" class="relative w-full min-h-[100dvh] flex flex-col justify-center items-center overflow-hidden text-ivory">
  <!-- Background Image with Parallax container -->
  <div class="hero-bg-container absolute inset-0 w-full h-[120%] -top-[10%] pointer-events-none">
    <img
      id="hero-bg-img"
      src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=2000&q=85"
      alt="Meriem & Refki Mariage"
      class="w-full h-full object-cover object-center brightness-[0.78] filter scale-105"
      loading="eager"
    />
    <!-- Luxury layered gradients -->
    <div class="absolute inset-0 bg-gradient-to-b from-charcoal/60 via-charcoal/30 to-charcoal/85"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_0%,rgba(26,24,22,0.6)_100%)]"></div>
  </div>

  <!-- Decorative Border Frame -->
  <div class="absolute inset-4 sm:inset-6 md:inset-10 border border-gold/20 pointer-events-none z-10 hidden sm:block"></div>
  <div class="absolute inset-6 sm:inset-8 md:inset-12 border border-gold/10 pointer-events-none z-10 hidden sm:block"></div>

  <!-- Main Hero Content -->
  <div class="relative z-20 flex flex-col items-center text-center px-4 max-w-4xl mx-auto mt-20 sm:mt-12">
    <!-- Subtitle / Tagline -->
    <div class="hero-fade overflow-hidden mb-3 sm:mb-4">
      <p class="text-[10px] sm:text-[11px] md:text-xs uppercase tracking-widest-2xl text-gold-light font-medium flex items-center justify-center gap-2 sm:gap-3">
        <span class="w-6 sm:w-8 h-px bg-gold/50 inline-block"></span>
        <span data-i18n="hero.badge">Célébration d'Amour</span>
        <span class="w-6 sm:w-8 h-px bg-gold/50 inline-block"></span>
      </p>
    </div>

    <!-- Couple Names in Grand Typography -->
    <div class="hero-title-wrap my-1 sm:my-2">
      <h1 class="font-serif text-4xl sm:text-7xl md:text-8xl lg:text-9xl font-light tracking-tight text-ivory leading-[0.98] select-none">
        <span data-i18n="hero.bride" class="hero-name block drop-shadow-lg">{wedding.bride.fr}</span>
        <span class="hero-amp block text-2xl sm:text-5xl md:text-6xl text-gold-300 font-serif italic my-1 sm:my-2 opacity-90 drop-shadow">
          &amp;
        </span>
        <span data-i18n="hero.groom" class="hero-name block drop-shadow-lg">{wedding.groom.fr}</span>
      </h1>
    </div>

    <!-- Wedding Date & Location -->
    <div class="hero-fade mt-8 md:mt-10 flex flex-col items-center">
      <div class="flex items-center gap-4 text-xs md:text-sm tracking-widest uppercase text-champagne/90 font-light">
        <span data-i18n="hero.date" class="font-medium text-ivory">{wedding.displayDate.fr}</span>
        <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
        <span data-i18n="hero.city" class="tracking-widest-xl">{wedding.city.fr}, {wedding.country.fr}</span>
      </div>

      <div class="w-12 h-px bg-gold/40 my-4"></div>

      <p data-i18n="location.venueName" class="text-xs md:text-sm italic font-serif text-gold-light/90 max-w-md px-4">
        {wedding.venue.name.fr}
      </p>
    </div>

    <!-- Call to action button -->
    <div class="hero-fade mt-8">
      <a
        href="#welcome"
        class="inline-flex items-center gap-2.5 px-6 py-2.5 rounded-full border border-gold/40 bg-charcoal/40 backdrop-blur-sm text-[11px] uppercase tracking-widest text-ivory hover:bg-gold-dark hover:border-gold transition-all duration-300"
      >
        <span data-i18n="hero.cta">Découvrir notre journée</span>
        <svg class="w-3 h-3 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Bottom Scroll Indicator -->
  <a
    href="#welcome"
    class="absolute bottom-8 z-20 flex flex-col items-center gap-2 text-ivory/60 hover:text-gold transition-colors duration-300 group"
    aria-label="Défiler vers le bas"
  >
    <span data-i18n="hero.scroll" class="text-[9px] uppercase tracking-widest-2xl text-gold-light/70 group-hover:text-gold transition-colors">Défiler</span>
    <div class="w-5 h-9 rounded-full border border-gold/40 flex justify-center p-1">
      <div class="w-1 h-2 rounded-full bg-gold animate-bounce"></div>
    </div>
  </a>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initHeroAnimations = () => {
    gsap.to('#hero-bg-img', {
      yPercent: 20,
      ease: 'none',
      scrollTrigger: {
        trigger: '#hero',
        start: 'top top',
        end: 'bottom top',
        scrub: true
      }
    });

    const heroTl = gsap.timeline({ delay: 0.2 });

    heroTl.from('.hero-name', {
      y: 60,
      opacity: 0,
      duration: 1.4,
      stagger: 0.25,
      ease: 'power3.out'
    })
    .from('.hero-amp', {
      scale: 0.6,
      opacity: 0,
      duration: 1,
      ease: 'back.out(1.7)'
    }, '-=1.0')
    .from('.hero-fade', {
      y: 20,
      opacity: 0,
      duration: 1,
      stagger: 0.15,
      ease: 'power2.out'
    }, '-=0.6');
  };

  window.addEventListener('invitation-opened', initHeroAnimations);

  if (!document.getElementById('opening-screen')) {
    initHeroAnimations();
  }
</script>
