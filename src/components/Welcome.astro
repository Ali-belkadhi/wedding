---
import { wedding } from '../data/wedding';
---

<section id="welcome" class="relative py-28 md:py-36 px-6 bg-ivory text-charcoal overflow-hidden">
  <!-- Subtle background watermark monogram -->
  <div class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-1/3 select-none pointer-events-none opacity-[0.03] text-[28rem] font-serif font-light text-gold leading-none">
    &amp;
  </div>

  <div class="max-w-3xl mx-auto text-center relative z-10">
    <!-- Botanical / Minimal Ornament -->
    <div class="welcome-reveal flex items-center justify-center gap-4 mb-8">
      <div class="w-12 h-px bg-gold/40"></div>
      <svg class="w-6 h-6 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
        <path d="M12 2C12 7.52 7.52 12 2 12C7.52 12 12 16.48 12 22C12 16.48 16.48 12 22 12C16.48 12 7.52 12 2Z" />
      </svg>
      <div class="w-12 h-px bg-gold/40"></div>
    </div>

    <!-- Small Badge -->
    <span data-i18n="welcome.badge" class="welcome-reveal inline-block text-[11px] uppercase tracking-widest-2xl text-gold-dark font-medium mb-5">
      {wedding.welcome.badge.fr}
    </span>

    <!-- Poetic Quote in Cormorant Garamond / Amiri -->
    <blockquote data-i18n="welcome.quote" class="welcome-reveal font-serif text-2xl sm:text-3xl md:text-4xl text-charcoal font-light italic leading-relaxed mb-8 max-w-2xl mx-auto">
      {wedding.welcome.quote.fr}
    </blockquote>

    <div class="welcome-reveal w-16 h-px bg-gold/30 mx-auto mb-8"></div>

    <!-- Heartfelt Invitation Message -->
    <p data-i18n="welcome.invitation" class="welcome-reveal text-charcoal/80 font-sans text-sm sm:text-base leading-loose font-light max-w-xl mx-auto mb-10">
      {wedding.welcome.invitation.fr}
    </p>

    <!-- Sign-off & Monogram -->
    <div class="welcome-reveal pt-4">
      <p data-i18n="welcome.signOff" class="font-serif italic text-base text-gold-dark mb-4">
        {wedding.welcome.signOff.fr}
      </p>
      <div class="font-serif text-3xl tracking-widest text-charcoal font-light">
        <span data-i18n="hero.bride">{wedding.bride.fr}</span> <span class="text-gold">&amp;</span> <span data-i18n="hero.groom">{wedding.groom.fr}</span>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.from('#welcome .welcome-reveal', {
    scrollTrigger: {
      trigger: '#welcome',
      start: 'top 75%',
      toggleActions: 'play none none none'
    },
    y: 35,
    opacity: 0,
    duration: 1.1,
    stagger: 0.15,
    ease: 'power3.out'
  });
</script>
