---
import Layout from '../layouts/Layout.astro';
import OpeningScreen from '../components/OpeningScreen.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Welcome from '../components/Welcome.astro';
import Story from '../components/Story.astro';
import Countdown from '../components/Countdown.astro';
import WeddingDetails from '../components/WeddingDetails.astro';
import Timeline from '../components/Timeline.astro';
import Gallery from '../components/Gallery.astro';
import Location from '../components/Location.astro';
import DressCode from '../components/DressCode.astro';
import RSVP from '../components/RSVP.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <!-- Full-screen Opening Monogram Curtain -->
  <OpeningScreen />

  <!-- Floating Navigation -->
  <Navbar />

  <main>
    <!-- Hero Section with Names, Date, Parallax -->
    <Hero />

    <!-- Welcome Section with Romantic Message -->
    <Welcome />

    <!-- Our Story Section -->
    <Story />

    <!-- Dynamic Countdown Section -->
    <Countdown />

    <!-- Wedding Details (Ceremony, Dinner, Party) -->
    <WeddingDetails />

    <!-- Schedule / Timeline Section -->
    <Timeline />

    <!-- Photo Gallery & Fullscreen Lightbox -->
    <Gallery />

    <!-- Venue Location & Map Section -->
    <Location />

    <!-- Dress Code & Color Swatches -->
    <DressCode />

    <!-- RSVP via WhatsApp & Calendar ICS -->
    <RSVP />
  </main>

  <!-- Floating Minimal Audio Player -->
  <MusicPlayer />

  <!-- Luxury Footer -->
  <Footer />
</Layout>
