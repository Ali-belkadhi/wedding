---
import { wedding } from '../data/wedding';
---

<section id="location" class="py-24 md:py-36 px-6 bg-ivory relative overflow-hidden">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 md:mb-20 location-header">
      <span data-i18n="location.badge" class="text-[11px] uppercase tracking-widest-2xl text-gold-dark font-medium block mb-3">
        Le Sanctuaire
      </span>
      <h2 data-i18n="location.title" class="font-serif text-3xl sm:text-4xl md:text-5xl font-light text-charcoal tracking-tight mb-4">
        Le Lieu de Célébration
      </h2>
      <p data-i18n="location.sub" class="text-xs md:text-sm font-light text-charcoal/70">
        Un écrin d'exception entre palmiers centenaires et brise marine.
      </p>
      <div class="w-12 h-px bg-gold/40 mx-auto mt-6"></div>
    </div>

    <!-- Main Location Card: Two Column Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-stretch location-card-wrap">
      <!-- Venue Visual -->
      <div class="lg:col-span-7 relative overflow-hidden rounded-2xl shadow-xl border border-gold/30 min-h-[340px] sm:min-h-[420px] group">
        <img
          src={wedding.venue.image}
          alt={wedding.venue.name.fr}
          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-charcoal/80 via-transparent to-transparent"></div>
        <div class="absolute bottom-6 left-6 right-6 text-ivory">
          <span data-i18n="location.venueSub" class="text-[10px] uppercase tracking-widest-xl text-gold-light block mb-1">
            {wedding.venue.subname.fr}
          </span>
          <h3 data-i18n="location.venueName" class="font-serif text-2xl sm:text-3xl font-light">
            {wedding.venue.name.fr}
          </h3>
        </div>
      </div>

      <!-- Venue Information & Actions -->
      <div class="lg:col-span-5 flex flex-col justify-between rounded-2xl bg-champagne-50 p-8 sm:p-10 border border-gold/25 shadow-sm">
        <div>
          <div class="w-12 h-12 rounded-full bg-ivory border border-gold/30 flex items-center justify-center mb-6">
            <svg class="w-5 h-5 text-gold-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>

          <h3 data-i18n="location.venueName" class="font-serif text-2xl sm:text-3xl font-light text-charcoal tracking-tight mb-2">
            {wedding.venue.name.fr}
          </h3>

          <p data-i18n="location.cityCountry" class="text-xs uppercase tracking-widest text-gold-dark font-medium mb-4">
            {wedding.city.fr}, {wedding.country.fr}
          </p>

          <p data-i18n="location.address" class="text-sm text-charcoal/75 leading-relaxed font-light mb-6">
            {wedding.venue.address.fr}
          </p>

          <div class="space-y-2.5 py-4 border-t border-gold/20 text-xs text-charcoal/70 font-light">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-gold flex-shrink-0"></span>
              <span data-i18n="location.valet">Service voiturier et parking privé surveillé</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-gold flex-shrink-0"></span>
              <span data-i18n="location.hotels">Hôtels et suites recommandés à proximité immédiate</span>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="mt-8 pt-6 border-t border-gold/20 flex flex-col sm:flex-row gap-3">
          <a
            href={wedding.venue.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-charcoal text-ivory text-xs uppercase tracking-widest font-medium border border-gold/40 hover:bg-gold-dark hover:border-gold hover:text-white transition-all duration-300 shadow-sm"
          >
            <svg class="w-4 h-4 text-gold-light" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
            </svg>
            <span data-i18n="location.btnMaps">Google Maps</span>
          </a>

          <a
            href={wedding.venue.directionsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-ivory text-charcoal text-xs uppercase tracking-widest font-medium border border-gold/40 hover:bg-champagne-100 hover:border-gold transition-all duration-300 shadow-sm"
          >
            <svg class="w-4 h-4 text-gold-dark rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
            <span data-i18n="location.btnDirections">Obtenir l'Itinéraire</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.from('#location .location-header', {
    scrollTrigger: {
      trigger: '#location',
      start: 'top 80%',
      toggleActions: 'play none none none'
    },
    y: 30,
    opacity: 0,
    duration: 1,
    ease: 'power3.out'
  });

  gsap.from('#location .location-card-wrap', {
    scrollTrigger: {
      trigger: '#location',
      start: 'top 75%',
      toggleActions: 'play none none none'
    },
    y: 40,
    opacity: 0,
    duration: 1.1,
    ease: 'power3.out'
  });
</script>
